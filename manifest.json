{
  "manifest_version": 2,
  "name": "STG Native Tab Groups CSS Fix (userChrome)",
  "version": "1.2.1",
  "description": "Автоматически прописывает CSS-исправление пустых плашек нативных групп (для STG) и опцию закрепления вкладок внутри свернутых групп в chrome/userChrome.css. При отключении откатывает свои правки.",
  "author": "Oleg",
  "homepage_url": "https://github.com/olegius88/stg-native-groups-css-fix",
  "browser_specific_settings": {
    "gecko": {
      "id": "stg-native-groups-css@olegius.org",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/olegius88/stg-native-groups-css-fix/main/updates.json"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "menus",
    "sessions"
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "STG Native Groups CSS (userChrome)",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "experiment_apis": {
    "userChromeManager": {
      "schema": "experiments/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["userChromeManager"]],
        "script": "experiments/api.js"
      }
    }
  }
}
